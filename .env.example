# CampusIQ Environment Configuration
# Backend Database (MongoDB Atlas connection string)
MONGODB_URI=

# Authentication
JWT_SECRET=
JWT_EXPIRE=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS & Allowed Origins
CORS_ORIGIN=http://localhost:5173,https://campusiq-tawny.vercel.app
CLIENT_URL=http://localhost:5173

# Frontend API URL (leave blank for relative /api in production)
VITE_API_URL=

# AI Configuration (Optional - rule-based fallback is used if omitted)
AI_PROVIDER=gemini
AI_API_KEY=
